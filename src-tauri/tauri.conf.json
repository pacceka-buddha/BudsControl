{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Buds Control",
  "version": "1.0.0",
  "identifier": "io.budscontrol.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/build-sidecar.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Buds Control contributors",
    "copyright": "MIT License. Based on BudsControl by amarsakore.",
    "shortDescription": "Control OnePlus, OPPO and realme earbuds from the tray",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh",
        "displayLanguageSelector": false,
        "startMenuFolder": "Buds Control"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "bluez",
          "libdbus-1-3",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ],
        "section": "utils"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "mainBinaryName": "BudsControl"
}
